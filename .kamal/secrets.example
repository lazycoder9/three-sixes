# Copy to .kamal/secrets and fill in.

# GitHub Container Registry token with packages:write.
KAMAL_REGISTRY_PASSWORD=ghp_xxxxxxxxxxxxxxxxxxxx

# mix phx.gen.secret
SECRET_KEY_BASE=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

DATABASE_PATH=/data/three_sixes.db

# Empty until Google sign-in (#19).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
